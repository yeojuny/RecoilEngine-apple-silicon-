+    offsets[0] = vec3( wid * 0.5, 0.0,  len * 0.5);
+    offsets[1] = vec3( wid * 0.5, 0.0, -len * 0.5);
+    offsets[2] = vec3(-wid * 0.5, 0.0,  len * 0.5);
+    offsets[3] = vec3(-wid * 0.5, 0.0, -len * 0.5);
