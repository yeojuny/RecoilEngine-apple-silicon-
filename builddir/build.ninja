# Utility command for test

build AI/Skirmish/CircuitAI/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /Users/yeojun/RecoilEngine/builddir/AI/Skirmish/CircuitAI && /opt/homebrew/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build AI/Skirmish/CircuitAI/test: phony AI/Skirmish/CircuitAI/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build AI/Skirmish/CircuitAI/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/yeojun/RecoilEngine/builddir/AI/Skirmish/CircuitAI && /opt/homebrew/bin/ccmake -S/Users/yeojun/RecoilEngine -B/Users/yeojun/RecoilEngine/builddir
  DESC = Running CMake cache editor...
